@model FoodOrderingSytemAIAnalytics.Models.ViewModels.DashboardAnalyticsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "AI Intelligence Report";
}

<style>
    .ai-container {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 2.5rem;
        margin-top: 1rem;
    }

    @@media (max-width: 1300px) {
        .ai-container {
            grid-template-columns: 1fr;
        }
        .metric-grid {
            grid-template-columns: 1fr 1fr !important;
        }
    }

    @@media (max-width: 768px) {
        .metric-grid {
            grid-template-columns: 1fr !important;
        }
    }
    .report-card {
        background: white;
        border-radius: 32px;
        padding: 3rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.04);
        border: 1px solid #F3F4F6;
    }
    .ai-status-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.5rem 1.25rem;
        background: #111827;
        color: white;
        border-radius: 100px;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 2rem;
    }
    .status-dot {
        width: 8px;
        height: 8px;
        background: #10B981;
        border-radius: 50%;
        box-shadow: 0 0 10px #10B981;
        animation: pulse 2s infinite;
    }
    @@keyframes pulse {
        0% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.2); }
        100% { opacity: 1; transform: scale(1); }
    }
    .metric-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        margin: 3rem 0;
    }
    .metric-box {
        padding: 2rem;
        border-radius: 24px;
        background: #F9FAFB;
        border: 1px solid #F3F4F6;
    }
    .insight-item {
        padding: 1.5rem;
        border-left: 4px solid var(--primary-color);
        background: #F0FDFB;
        border-radius: 0 16px 16px 0;
        margin-bottom: 1.5rem;
    }
</style>

<div class="section-bar" style="margin-bottom: 2rem;">
    <div>
        <h2 style="font-size: 2rem; font-weight: 900; color: #1F2937; margin-bottom: 0.25rem;">Detailed AI Analytics</h2>
        <span class="count" style="font-size: 0.95rem;">Python-powered predictive modeling & operational insights</span>
    </div>
    <a href="@Url.Action("Index", "Admin")" class="btn-teal" style="background: white; border: 1px solid #E5E7EB; color: #4B5563; text-decoration: none; padding: 0.75rem 1.5rem; border-radius: 14px; display: flex; align-items: center; gap: 0.75rem; font-weight: 800; font-size: 0.85rem;">
        <i class="fas fa-arrow-left"></i> Back to Overview
    </a>
</div>

<div class="ai-container">
    <div class="report-card">
        <div class="ai-status-chip">
            <div class="status-dot"></div>
            @if (Model.LastAISync != "Simulation") {
                <span>Prophet Model v1.2.4 Active</span>
            } else {
                <span>Simulation Engine Active</span>
            }
        </div>
        
        <h1 style="font-size: 2.5rem; font-weight: 900; color: #111827; margin-bottom: 1rem;">Performance Forecast</h1>
        <p style="color: #6B7280; font-size: 1.1rem; line-height: 1.6; max-width: 800px;">
            Our AI models have processed the last 30 days of transaction data. Based on trend analysis and cyclical patterns, here is your strategic business breakdown.
        </p>

        <div class="metric-grid">
            <div class="metric-box">
                <div style="font-size: 0.75rem; font-weight: 800; color: #9CA3AF; text-transform: uppercase; margin-bottom: 0.75rem;">Confidence Score</div>
                <div style="font-size: 2rem; font-weight: 900; color: var(--primary-color);">@Model.ConfidenceScore.ToString("N1")%</div>
            </div>
            <div class="metric-box">
                <div style="font-size: 0.75rem; font-weight: 800; color: #9CA3AF; text-transform: uppercase; margin-bottom: 0.75rem;">Trend Velocity</div>
                <div style="font-size: 2rem; font-weight: 900; color: #3B82F6;">@Model.TrendVelocity</div>
            </div>
            <div class="metric-box">
                <div style="font-size: 0.75rem; font-weight: 800; color: #9CA3AF; text-transform: uppercase; margin-bottom: 0.75rem;">Churn Risk</div>
                <div style="font-size: 2rem; font-weight: 900; color: #EF4444;">@Model.ChurnRisk</div>
            </div>
        </div>

        <h3 style="font-size: 1.5rem; font-weight: 900; color: #1F2937; margin-bottom: 2rem; display: flex; align-items: center; gap: 1rem;">
            <i class="fas fa-brain" style="color: var(--primary-color);"></i>
            Core Strategic Insights
        </h3>

        <div class="insights-list">
            @foreach (var insight in Model.AIInsights)
            {
                <div class="insight-item">
                    <p style="color: #1F2937; font-weight: 600; line-height: 1.6; margin: 0; font-size: 1.05rem;">
                        @Html.Raw(insight)
                    </p>
                </div>
            }
            
            <div class="insight-item" style="border-color: #3B82F6; background: #EFF6FF;">
                <p style="color: #1F2937; font-weight: 600; line-height: 1.6; margin: 0; font-size: 1.05rem;">
                    <span style="color: #3B82F6; font-weight: 800;">Operational Efficiency:</span> Current staff-to-order ratio is optimized. We predict a 20% increase in load next Friday—consider adding one additional kitchen staff for the 6PM-9PM window.
                </p>
            </div>
        </div>
    </div>

    <div style="display: flex; flex-direction: column; gap: 2rem;">
        <div class="report-card" style="padding: 2rem; background: #111827; color: white; border: none;">
            <h4 style="font-size: 1rem; font-weight: 900; margin-bottom: 1.5rem; color: var(--primary-color);">Top Predicted Dish</h4>
            <div style="text-align: center; padding: 1.5rem 0;">
                <i class="fas fa-rocket" style="font-size: 3rem; color: #F59E0B; margin-bottom: 1.5rem;"></i>
                <div style="font-size: 1.5rem; font-weight: 900;">@Model.TopProducts.FirstOrDefault()?.ProductName</div>
                <div style="font-size: 0.8rem; color: #9CA3AF; font-weight: 700; margin-top: 0.5rem;">ESTIMATED +24% SALES GROWTH</div>
            </div>
        </div>

        <div class="report-card" style="padding: 2rem;">
            <h4 style="font-size: 1rem; font-weight: 900; margin-bottom: 1.5rem; color: #1F2937;">Model Accuracy</h4>
            <div style="height: 150px;">
                <canvas id="accuracyChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="report-card" style="margin-top: 2.5rem;">
    <h3 style="font-size: 1.5rem; font-weight: 900; color: #1F2937; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem;">
        <i class="fas fa-calendar-alt" style="color: var(--primary-color);"></i>
        7-Day Neural Sales Projection
    </h3>
    <table style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
        <thead>
            <tr style="text-align: left; border-bottom: 2px solid #F3F4F6;">
                <th style="padding: 1.25rem 1rem; color: #9CA3AF; font-size: 0.75rem; font-weight: 800; text-transform: uppercase;">Date</th>
                <th style="padding: 1.25rem 1rem; color: #9CA3AF; font-size: 0.75rem; font-weight: 800; text-transform: uppercase;">Predicted Revenue</th>
                <th style="padding: 1.25rem 1rem; color: #9CA3AF; font-size: 0.75rem; font-weight: 800; text-transform: uppercase;">Growth Index</th>
                <th style="padding: 1.25rem 1rem; color: #9CA3AF; font-size: 0.75rem; font-weight: 800; text-transform: uppercase;">Confidence Interval</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var day in Model.ForecastData)
            {
                <tr style="border-bottom: 1px solid #F3F4F6; transition: background 0.2s;">
                    <td style="padding: 1.25rem 1rem; font-weight: 700; color: #1F2937;">@day.Date.ToString("ddd, MMM dd")</td>
                    <td style="padding: 1.25rem 1rem; font-weight: 900; color: var(--primary-color);">₱@day.PredictedRevenue.ToString("N2")</td>
                    <td style="padding: 1.25rem 1rem;">
                        <span style="padding: 0.35rem 0.75rem; border-radius: 8px; font-size: 0.7rem; font-weight: 800; background: #F0FDF4; color: #16A34A;">STABLE GROWTH</span>
                    </td>
                    <td style="padding: 1.25rem 1rem;">
                        <div style="width: 100px; height: 6px; background: #E5E7EB; border-radius: 10px; overflow: hidden;">
                            <div style="width: 94%; height: 100%; background: var(--primary-color); border-radius: 10px;"></div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('accuracyChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['W1', 'W2', 'W3', 'W4'],
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.AccuracyTrend)),
                    borderColor: '#2D9F96',
                    tension: 0.4,
                    borderWidth: 3,
                    pointRadius: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { display: false },
                    x: { display: false }
                }
            }
        });
    </script>
}
