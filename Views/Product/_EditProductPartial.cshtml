@model FoodOrderingSytemAIAnalytics.Models.Product

<div style="padding: 2rem; max-height: 90vh; overflow-y: auto;">
    <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
            <h2 style="font-size: 1.25rem; font-weight: 900; color: #1F2937; margin-bottom: 0.25rem;">Edit Dish</h2>
            <p style="color: #9CA3AF; font-weight: 700; font-size: 0.75rem; text-transform: uppercase;">"@Model.Name"</p>
        </div>
        <button type="button" onclick="document.getElementById('productModal').style.display='none'" style="background: none; border: none; color: #9CA3AF; cursor: pointer; font-size: 1.25rem;">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <form asp-controller="Product" asp-action="Edit" method="post" enctype="multipart/form-data" class="premium-form">
        <input type="hidden" asp-for="Id" />
        @* Removed hidden ImageUrl to allow text input to take precedence *@
        <div asp-validation-summary="ModelOnly" style="color: #EF4444; margin-bottom: 1rem; font-weight: 700; font-size: 0.8rem;"></div>

        <div style="margin-bottom: 1.25rem; background: #F9FAFB; padding: 1rem; border-radius: 16px; border: 1px solid #E5E7EB;">
            <label asp-for="ImageFile" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.75rem;">Dish Photo</label>
            <div style="display: flex; gap: 1rem; align-items: center;">
                <div style="width: 64px; height: 64px; border-radius: 12px; background: #F3F4F6; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid #E5E7EB; flex-shrink: 0;">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" style="width: 100%; height: 100%; object-fit: cover;" id="imagePreview" />
                    }
                    else
                    {
                        <i class="fas fa-image" style="font-size: 1.5rem; color: #D1D5DB;" id="imagePlaceholder"></i>
                    }
                </div>
                <div style="flex: 1;">
                    <div style="border: 1.5px dashed #D1D5DB; border-radius: 12px; padding: 0.75rem; text-align: center; background: white; cursor: pointer;" onclick="document.getElementById('ImageFile').click();">
                        <p style="margin: 0; font-weight: 700; color: #4B5563; font-size: 0.7rem;">Click to replace photo</p>
                        <input asp-for="ImageFile" type="file" style="display: none;" onchange="updateFileName(this)" />
                    </div>
                    <div id="fileNameDisplay" style="margin-top: 0.4rem; font-weight: 800; color: var(--primary-color); font-size: 0.65rem; display: none; word-break: break-all;"></div>
                </div>
            </div>
        </div>

        <div style="margin-bottom: 1.25rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                <span style="color: #9CA3AF; font-weight: 700; font-size: 0.65rem; text-transform: uppercase;">Image Address / URL</span>
                <div style="flex: 1; height: 1px; background: #F3F4F6;"></div>
            </div>
            <input asp-for="ImageUrl" class="form-control" placeholder="https://..." style="height: 40px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 0.85rem; width: 100%; font-size: 0.85rem;" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
            <div class="form-group">
                <label asp-for="Name" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem;">Dish Name</label>
                <input asp-for="Name" class="form-control" style="height: 40px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 0.85rem; width: 100%; font-size: 0.85rem;" />
            </div>
            <div class="form-group">
                <label asp-for="Code" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem;">Code</label>
                <input asp-for="Code" class="form-control" style="height: 40px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 0.85rem; width: 100%; font-size: 0.85rem;" />
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
            <div class="form-group">
                <label asp-for="Category" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem;">Category</label>
                <select asp-for="Category" class="form-control" style="height: 40px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 0.85rem; width: 100%; font-size: 0.85rem;">
                    @if (ViewBag.Categories != null)
                    {
                        @foreach (var cat in (IEnumerable<FoodOrderingSytemAIAnalytics.Models.Category>)ViewBag.Categories)
                        {
                            <option value="@cat.Name">@cat.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Price" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem;">Price (₱)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" style="height: 40px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 0.85rem; width: 100%; font-size: 0.85rem;" />
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
            <div class="form-group">
                <label asp-for="Stock" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem;">Stock</label>
                <input asp-for="Stock" type="number" class="form-control" style="height: 40px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 0.85rem; width: 100%; font-size: 0.85rem;" />
            </div>
            <div class="form-group" style="display: flex; align-items: center; gap: 0.5rem; padding-top: 1.25rem;">
                <input asp-for="IsActive" type="checkbox" style="width: 16px; height: 16px;" />
                <label asp-for="IsActive" style="font-weight: 800; color: #4B5563; font-size: 0.75rem;">Active</label>
            </div>
        </div>

        <div style="display: flex; gap: 0.75rem; margin-top: 0.5rem; padding-bottom: 0.5rem;">
            <button type="submit" class="btn-checkout" style="flex: 1; height: 48px; border-radius: 12px; font-weight: 900; font-size: 0.9rem;">
                <i class="fas fa-save"></i> Save Changes
            </button>
            <button type="button" onclick="document.getElementById('productModal').style.display='none'" class="btn-checkout" style="width: 100px; height: 48px; border-radius: 12px; font-weight: 900; font-size: 0.9rem; background: #F3F4F6; color: #4B5563; box-shadow: none;">
                Cancel
            </button>
        </div>
    </form>
</div>
