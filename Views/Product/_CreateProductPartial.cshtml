@model FoodOrderingSytemAIAnalytics.Models.Product

<div style="padding: 2rem; max-height: 90vh; overflow-y: auto;">
    <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
            <h2 style="font-size: 1.25rem; font-weight: 900; color: #1F2937; margin-bottom: 0.25rem;">Add New Dish</h2>
            <p style="color: #9CA3AF; font-weight: 700; font-size: 0.75rem; text-transform: uppercase;">Create a new item for your digital menu</p>
        </div>
        <button type="button" onclick="document.getElementById('productModal').style.display='none'" style="background: none; border: none; color: #9CA3AF; cursor: pointer; font-size: 1.25rem;">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <form asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data" class="premium-form">
        <div asp-validation-summary="ModelOnly" style="color: #EF4444; margin-bottom: 1rem; font-weight: 700; font-size: 0.8rem;"></div>

        <div style="margin-bottom: 1.25rem; background: #F9FAFB; padding: 1rem; border-radius: 16px; border: 1px solid #E5E7EB;">
            <label asp-for="ImageFile" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.75rem;">Upload Dish Photo</label>
            <div style="border: 1.5px dashed #D1D5DB; border-radius: 12px; padding: 1rem; text-align: center; background: white; transition: all 0.2s; cursor: pointer;" onclick="document.getElementById('ImageFile').click();">
                <i class="fas fa-cloud-upload-alt" style="font-size: 1.5rem; color: var(--primary-color); margin-bottom: 0.4rem;"></i>
                <p style="margin: 0; font-weight: 700; color: #4B5563; font-size: 0.7rem;">Click to upload or drag and drop</p>
                <input asp-for="ImageFile" type="file" style="display: none;" onchange="updateFileName(this)" />
            </div>
            <div id="fileNameDisplay" style="margin-top: 0.5rem; font-weight: 800; color: var(--primary-color); font-size: 0.65rem; display: none; text-align: center;"></div>
        </div>

        <div style="margin-bottom: 1.25rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                <span style="color: #9CA3AF; font-weight: 700; font-size: 0.65rem; text-transform: uppercase;">OR PROVIDE URL</span>
                <div style="flex: 1; height: 1px; background: #F3F4F6;"></div>
            </div>
            <input asp-for="ImageUrl" class="form-control" placeholder="https://..." style="height: 40px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 0.85rem; width: 100%; font-size: 0.85rem;" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
            <div class="form-group">
                <label asp-for="Name" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem;">Dish Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Wagyu Burger" style="height: 40px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 0.85rem; width: 100%; font-size: 0.85rem;" />
            </div>
            <div class="form-group">
                <label asp-for="Code" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem;">Code</label>
                <input asp-for="Code" class="form-control" placeholder="BRG-001" style="height: 40px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 0.85rem; width: 100%; font-size: 0.85rem;" />
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
            <div class="form-group">
                <label asp-for="Category" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem;">Category</label>
                <select asp-for="Category" class="form-control" style="height: 40px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 0.85rem; width: 100%; font-size: 0.85rem;">
                    @if (ViewBag.Categories != null)
                    {
                        @foreach (var cat in (IEnumerable<FoodOrderingSytemAIAnalytics.Models.Category>)ViewBag.Categories)
                        {
                            <option value="@cat.Name">@cat.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Price" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem;">Price (₱)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" style="height: 40px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 0.85rem; width: 100%; font-size: 0.85rem;" />
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
            <div class="form-group">
                <label asp-for="Stock" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem;">Stock</label>
                <input asp-for="Stock" type="number" class="form-control" style="height: 40px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 0.85rem; width: 100%; font-size: 0.85rem;" />
            </div>
            <div class="form-group">
                <label asp-for="DiscountPercent" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem;">Discount (%)</label>
                <input asp-for="DiscountPercent" type="number" step="0.01" class="form-control" style="height: 40px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 0.85rem; width: 100%; font-size: 0.85rem;" />
            </div>
        </div>

        <button type="submit" class="btn-checkout" style="width: 100%; height: 50px; border-radius: 12px; font-weight: 900; font-size: 1rem; margin-bottom: 0.5rem;">
            <i class="fas fa-plus"></i> Add to Menu
        </button>
    </form>
</div>
