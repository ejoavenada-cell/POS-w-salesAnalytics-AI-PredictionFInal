@model IEnumerable<FoodOrderingSytemAIAnalytics.Models.Product>
@{
    ViewData["Title"] = "Manage Products";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h2>Manage Products</h2>
    <a asp-action="Create" class="btn-primary" style="width: auto; padding: 0.5rem 1.5rem;">Add New Product</a>
</div>

<div class="card" style="background: white; padding: 1.5rem; border-radius: 0.75rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
    <form asp-action="Index" method="get" style="display: flex; gap: 1rem; margin-bottom: 1.5rem;">
        <input type="text" name="searchTerm" class="form-control" placeholder="Search by name or code..." value="@ViewBag.SearchTerm">
        <select name="category" class="form-control" style="width: 200px;">
            <option value="">All Categories</option>
            <option value="Meals">Meals</option>
            <option value="Drinks">Drinks</option>
            <option value="Sides">Sides</option>
            <option value="Desserts">Desserts</option>
        </select>
        <button type="submit" class="btn-primary" style="width: auto;">Filter</button>
    </form>

    <table class="table" style="width: 100%; border-collapse: collapse;">
        <thead>
            <tr style="text-align: left; border-bottom: 2px solid var(--border-color);">
                <th style="padding: 1rem;">Code</th>
                <th style="padding: 1rem;">Name</th>
                <th style="padding: 1rem;">Category</th>
                <th style="padding: 1rem;">Price</th>
                <th style="padding: 1rem;">Stock</th>
                <th style="padding: 1rem;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr style="border-bottom: 1px solid var(--border-color);">
                    <td style="padding: 1rem;">@item.Code</td>
                    <td style="padding: 1rem;">@item.Name</td>
                    <td style="padding: 1rem;">@item.Category</td>
                    <td style="padding: 1rem;">₱@item.Price.ToString("N2")</td>
                    <td style="padding: 1rem;">
                        @item.Stock
                        <button onclick="restock(@item.Id, '@item.Name')" style="border: none; background: none; color: var(--secondary-color); cursor: pointer;"><i class="fa fa-plus-circle"></i></button>
                    </td>
                    <td style="padding: 1rem;">
                        <a asp-action="Edit" asp-route-id="@item.Id" style="color: var(--secondary-color); margin-right: 1rem;"><i class="fa fa-edit"></i></a>
                        <a href="javascript:void(0)" onclick="confirmDelete(@item.Id, '@item.Name')" style="color: var(--accent-color);"><i class="fa fa-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" style="display:none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div style="background: white; padding: 2rem; border-radius: 1rem; width: 400px;">
        <h3>Confirm Deletion</h3>
        <p id="deleteMsg" style="margin: 1rem 0; color: var(--text-muted);"></p>
        <form asp-action="Delete" method="post">
            <input type="hidden" name="id" id="deleteId">
            <input type="text" name="confirmName" class="form-control" placeholder="Type product name to confirm..." required>
            <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
                <button type="button" onclick="closeModal()" class="form-control">Cancel</button>
                <button type="submit" class="btn-primary" style="background: var(--accent-color);">Delete Forever</button>
            </div>
        </form>
    </div>
</div>

<script>
    function confirmDelete(id, name) {
        document.getElementById('deleteId').value = id;
        document.getElementById('deleteMsg').innerText = `To delete "${name}", please type the product name below to confirm.`;
        document.getElementById('deleteModal').style.display = 'flex';
    }
    function closeModal() {
        document.getElementById('deleteModal').style.display = 'none';
    }
    function restock(id, name) {
        const qty = prompt(`Enter restock quantity for ${name}:`, "10");
        if (qty && !isNaN(qty)) {
            fetch(`/Product/Restock?productId=${id}&quantity=${qty}`, { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    if (res.success) location.reload();
                    else alert(res.message);
                });
        }
    }
</script>
