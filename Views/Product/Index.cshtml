@model IEnumerable<FoodOrderingSytemAIAnalytics.Models.Product>
@{
    ViewData["Title"] = "Manage Products";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h2>Manage Products</h2>
    <a asp-action="Create" class="btn-primary" style="width: auto; padding: 0.5rem 1.5rem;">Add New Product</a>
</div>

<div class="card" style="background: white; padding: 1.5rem; border-radius: 0.75rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
    <form asp-action="Index" method="get" style="display: flex; gap: 1rem; margin-bottom: 1.5rem;">
        <input type="text" name="searchTerm" class="form-control" placeholder="Search by name or code..." value="@ViewBag.SearchTerm">
        <select name="category" class="form-control" style="width: 200px;">
            <option value="">All Categories</option>
            <option value="Meals">Meals</option>
            <option value="Drinks">Drinks</option>
            <option value="Sides">Sides</option>
            <option value="Desserts">Desserts</option>
        </select>
        <button type="submit" class="btn-primary" style="width: auto;">Filter</button>
    </form>

    <table class="table" style="width: 100%; border-collapse: collapse; table-layout: fixed;">
        <thead>
            <tr style="text-align: left; border-bottom: 2px solid var(--border-color); color: #6B7280; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">
                <th style="padding: 1rem 0.5rem; width: 80px;">Code</th>
                <th style="padding: 1rem 0.5rem; width: 60px;">Photo</th>
                <th style="padding: 1rem 0.5rem;">Product Name</th>
                <th style="padding: 1rem 0.5rem; width: 120px;">Category</th>
                <th style="padding: 1rem 0.5rem; width: 100px;">Price</th>
                <th style="padding: 1rem 0.5rem; width: 110px;">Stock</th>
                <th style="padding: 1rem 0.5rem; width: 100px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr style="border-bottom: 1px solid #F3F4F6; transition: background 0.2s;" onmouseover="this.style.background='#F9FAFB'" onmouseout="this.style.background='transparent'">
                    <td style="padding: 1rem 0.5rem; font-family: monospace; font-size: 0.8rem; color: #9CA3AF;">@item.Code</td>
                    <td style="padding: 1rem 0.5rem;">
                        <div style="width: 45px; height: 45px; border-radius: 10px; background: #F3F4F6; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid #E5E7EB;">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <span style="font-size: 1.2rem;">🍔</span>
                            }
                        </div>
                    </td>
                    <td style="padding: 1rem 0.5rem; font-weight: 700; color: #111827;">@item.Name</td>
                    <td style="padding: 1rem 0.5rem;">
                        <span style="padding: 0.25rem 0.75rem; border-radius: 20px; background: #EEF2FF; color: #4F46E5; font-size: 0.7rem; font-weight: 700; display: inline-block;">@item.Category</span>
                    </td>
                    <td style="padding: 1rem 0.5rem; font-weight: 800; color: #111827;">₱@item.Price.ToString("N2")</td>
                    <td style="padding: 1rem 0.5rem;">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="font-weight: 700; @(item.Stock < 20 ? "color: #EF4444;" : "color: #10B981;")">@item.Stock</span>
                            <button onclick="restock(@item.Id, '@item.Name')" title="Restock" style="border: none; background: #F3F4F6; color: #4B5563; width: 24px; height: 24px; border-radius: 6px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>
                    </td>
                    <td style="padding: 1rem 0.5rem;">
                        <div style="display: flex; gap: 0.5rem;">
                            <a asp-action="Edit" asp-route-id="@item.Id" style="width: 32px; height: 32px; border-radius: 8px; background: #EEF2FF; color: #4F46E5; display: flex; align-items: center; justify-content: center;"><i class="fa fa-edit"></i></a>
                            <a href="javascript:void(0)" onclick="confirmDelete(@item.Id, '@item.Name')" style="width: 32px; height: 32px; border-radius: 8px; background: #FEF2F2; color: #EF4444; display: flex; align-items: center; justify-content: center;"><i class="fa fa-trash"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" style="display:none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div style="background: white; padding: 2rem; border-radius: 1rem; width: 400px;">
        <h3>Confirm Deletion</h3>
        <p id="deleteMsg" style="margin: 1rem 0; color: var(--text-muted);"></p>
        <form asp-action="Delete" method="post">
            <input type="hidden" name="id" id="deleteId">
            <input type="text" name="confirmName" class="form-control" placeholder="Type product name to confirm..." required>
            <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
                <button type="button" onclick="closeModal()" class="form-control">Cancel</button>
                <button type="submit" class="btn-primary" style="background: var(--accent-color);">Delete Forever</button>
            </div>
        </form>
    </div>
</div>

<script>
    function confirmDelete(id, name) {
        document.getElementById('deleteId').value = id;
        document.getElementById('deleteMsg').innerText = `To delete "${name}", please type the product name below to confirm.`;
        document.getElementById('deleteModal').style.display = 'flex';
    }
    function closeModal() {
        document.getElementById('deleteModal').style.display = 'none';
    }
    function restock(id, name) {
        const qty = prompt(`Enter restock quantity for ${name}:`, "10");
        if (qty && !isNaN(qty)) {
            fetch(`/Product/Restock?productId=${id}&quantity=${qty}`, { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    if (res.success) location.reload();
                    else alert(res.message);
                });
        }
    }
</script>
