@model FoodOrderingSytemAIAnalytics.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Staff Registration";
    Layout = "_Layout";
}

<div class="login-container" style="background: linear-gradient(135deg, #2D9F96 0%, #1a5e59 100%); height: auto; min-height: 100vh; padding: 4rem 0;">
    <div class="login-card" style="border-radius: 24px; padding: 3rem; max-width: 500px;">
        <div class="login-header">
            <div style="width: 60px; height: 60px; background: var(--primary-color); border-radius: 16px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.75rem; margin: 0 auto 1.5rem;">
                <i class="fas fa-user-plus"></i>
            </div>
            <h1 style="font-size: 2rem; font-weight: 800; color: #1F2937;">Join the Team</h1>
            <p style="color: var(--text-muted); margin-top: 0.5rem; font-weight: 500;">Create your staff profile</p>
        </div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="error-message" style="margin-bottom: 1rem; text-align: center;"></div>

            <div class="form-group">
                <label asp-for="Username" style="font-weight: 600; color: #4B5563;">Full Name</label>
                <input asp-for="Username" class="form-control" placeholder="John Doe" style="height: 52px; border-radius: 12px; border: 2px solid #F3F4F6; background: #F9FAFB;" />
                <span asp-validation-for="Username" class="error-message"></span>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                <div class="form-group">
                    <label asp-for="Age" style="font-weight: 600; color: #4B5563;">Age</label>
                    <input asp-for="Age" type="number" class="form-control" placeholder="Age" style="height: 52px; border-radius: 12px; border: 2px solid #F3F4F6; background: #F9FAFB;" />
                    <span asp-validation-for="Age" class="error-message"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Sex" style="font-weight: 600; color: #4B5563;">Sex</label>
                    <select asp-for="Sex" class="form-control" style="height: 52px; border-radius: 12px; border: 2px solid #F3F4F6; background: #F9FAFB;">
                        <option value="">Select...</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="Sex" class="error-message"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Role" style="font-weight: 600; color: #4B5563;">Assign Role</label>
                <select asp-for="Role" class="form-control" style="height: 52px; border-radius: 12px; border: 2px solid #F3F4F6; background: #F9FAFB;">
                    <option value="Staff">Staff Terminal User</option>
                    <option value="Admin">System Administrator</option>
                </select>
                <span asp-validation-for="Role" class="error-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" style="font-weight: 600; color: #4B5563;">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" style="height: 52px; border-radius: 12px; border: 2px solid #F3F4F6; background: #F9FAFB;" />
                <span asp-validation-for="Password" class="error-message"></span>
            </div>

            <div class="form-group" style="margin-bottom: 2rem;">
                <label asp-for="ConfirmPassword" style="font-weight: 600; color: #4B5563;">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" style="height: 52px; border-radius: 12px; border: 2px solid #F3F4F6; background: #F9FAFB;" />
                <span asp-validation-for="ConfirmPassword" class="error-message"></span>
            </div>

            <button type="submit" class="btn-primary" style="height: 56px; border-radius: 16px; font-size: 1.125rem; font-weight: 700; background: var(--primary-color); box-shadow: 0 10px 15px -3px rgba(45, 159, 150, 0.3);">Register Account</button>
        </form>

        <div style="margin-top: 2rem; text-align: center; font-size: 0.875rem;">
            <span style="color: var(--text-muted); font-weight: 500;">Already part of Tasty Station?</span>
            <a href="@Url.Action("Login", "Auth")" style="color: var(--primary-color); text-decoration: none; font-weight: 700;">Sign in here</a>
        </div>
    </div>
</div>
