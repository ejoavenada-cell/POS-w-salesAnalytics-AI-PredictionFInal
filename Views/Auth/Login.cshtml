@model FoodOrderingSytemAIAnalytics.Models.ViewModels.LoginViewModel
@inject FoodOrderingSytemAIAnalytics.Data.ApplicationDbContext _context
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
    var settings = _context.StoreSettings.FirstOrDefault() ?? new FoodOrderingSytemAIAnalytics.Models.StoreSetting();
}

<div class="login-container" style="background: linear-gradient(135deg, #2D9F96 0%, #1a5e59 100%);">
    <div class="login-card" style="border-radius: 24px; padding: 3rem;">
        <div class="login-header">
            <div style="width: 80px; height: 80px; background: white; border-radius: 20px; display: flex; align-items: center; justify-content: center; color: var(--primary-color); font-size: 2.5rem; margin: 0 auto 1.5rem; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
                @if (!string.IsNullOrEmpty(settings.LogoUrl))
                {
                    <img src="@settings.LogoUrl" style="width: 100%; height: 100%; object-fit: contain;" />
                }
                else
                {
                    <i class="fas fa-utensils"></i>
                }
            </div>
            <h1 style="font-size: 2rem; font-weight: 800; color: #1F2937;">@settings.StoreName</h1>
            <p style="color: var(--text-muted); margin-top: 0.5rem; font-weight: 500;">Please enter your credentials</p>
        </div>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="error-message" style="margin-bottom: 1rem; text-align: center;"></div>

            <div class="form-group">
                <label asp-for="Name" style="font-weight: 600; color: #4B5563;">Username</label>
                <input asp-for="Name" class="form-control" placeholder="admin / staff" style="height: 52px; border-radius: 12px; border: 2px solid #F3F4F6; background: #F9FAFB;" />
                <span asp-validation-for="Name" class="error-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" style="font-weight: 600; color: #4B5563;">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" style="height: 52px; border-radius: 12px; border: 2px solid #F3F4F6; background: #F9FAFB;" />
                <span asp-validation-for="Password" class="error-message"></span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <input type="checkbox" id="remember" style="width: 18px; height: 18px; accent-color: var(--primary-color);">
                    <label for="remember" style="font-size: 0.875rem; color: #6B7280; font-weight: 500;">Remember me</label>
                </div>
                <a href="#" style="font-size: 0.875rem; color: var(--primary-color); font-weight: 600; text-decoration: none;">Forgot password?</a>
            </div>

            <button type="submit" class="btn-primary" style="height: 56px; border-radius: 16px; font-size: 1.125rem; font-weight: 700; background: var(--primary-color); box-shadow: 0 10px 15px -3px rgba(45, 159, 150, 0.3);">Sign In</button>
        </form>

        <div style="margin-top: 2rem; text-align: center; font-size: 0.875rem;">
            <span style="color: var(--text-muted); font-weight: 500;">New staff member?</span>
            <a href="@Url.Action("Register", "Auth")" style="color: var(--primary-color); text-decoration: none; font-weight: 700;">Join our team</a>
        </div>
    </div>
</div>
