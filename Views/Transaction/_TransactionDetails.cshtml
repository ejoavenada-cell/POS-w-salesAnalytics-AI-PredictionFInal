@model FoodOrderingSytemAIAnalytics.Models.Transaction
@inject FoodOrderingSytemAIAnalytics.Data.ApplicationDbContext _context
@{
    var settings = _context.StoreSettings.FirstOrDefault() ?? new FoodOrderingSytemAIAnalytics.Models.StoreSetting();
}

<style>
    @@media print {
        @@page { 
            margin: 0; 
        }
        body { 
            background: white !important;
        }
        /* Hide everything by default */
        body * { visibility: hidden; }
        /* Only show the receipt container */
        #printable-receipt, #printable-receipt * { visibility: visible; }
        #printable-receipt {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            padding: 40px !important;
            margin: 0 !important;
            background: white !important;
        }
        .no-print { display: none !important; }
        .print-bw { filter: grayscale(100%) contrast(150%); color: black !important; }
        .total-banner { background: #f0f0f0 !important; color: black !important; border: 2px solid black !important; box-shadow: none !important; }
    }
</style>

<div id="printable-receipt" class="receipt-container" style="padding: 2.5rem; position: relative; background: white;">
    <!-- Close Button -->
    <button onclick="document.getElementById('detailsModal').style.display='none'" 
            class="no-print"
            style="position: absolute; top: 1.5rem; right: 1.5rem; border: none; background: #F3F4F6; width: 32px; height: 32px; border-radius: 50%; color: #6B7280; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; z-index: 10;">
        <i class="fas fa-times"></i>
    </button>

    <div style="text-align: center; margin-bottom: 2rem; padding-top: 1rem;">
        @if (!string.IsNullOrEmpty(settings.LogoUrl))
        {
            <img src="@settings.LogoUrl" class="print-bw" style="width: 80px; height: 80px; object-fit: contain; margin-bottom: 1rem;" alt="Logo" />
        }
        else
        {
            <div class="print-bw" style="width: 70px; height: 70px; background: #111827; color: white; border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 1.75rem; font-weight: 900; margin: 0.5rem auto 1.25rem;">@(settings.StoreName.Length > 2 ? settings.StoreName.Substring(0, 2).ToUpper() : settings.StoreName.ToUpper())</div>
        }
        <h2 style="font-size: 1.5rem; font-weight: 900; color: #1F2937; margin-bottom: 0.25rem;">@settings.StoreName</h2>
        <p style="color: #9CA3AF; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; margin: 0;">OFFICIAL RECEIPT</p>
        <p style="color: #9CA3AF; font-weight: 700; font-size: 0.75rem; margin-top: 0.25rem;">Code: @Model.TransactionCode</p>
    </div>

    <div style="border-top: 1px solid #F3F4F6; border-bottom: 1px solid #F3F4F6; padding: 1.25rem 0; margin-bottom: 2rem;">
        <div style="display:flex; justify-content:space-between; margin-bottom: 0.5rem;">
            <span style="color: #9CA3AF; font-weight: 700; font-size: 0.75rem; text-transform: uppercase;">Date & Time</span>
            <span style="color: #1F2937; font-weight: 800; font-size: 0.85rem;">@Model.Date.ToString("MMM dd, yyyy • HH:mm")</span>
        </div>
        <div style="display:flex; justify-content:space-between;">
            <span style="color: #9CA3AF; font-weight: 700; font-size: 0.75rem; text-transform: uppercase;">Served By</span>
            <span style="color: #1F2937; font-weight: 800; font-size: 0.85rem;">@Model.User.Name</span>
        </div>
    </div>

    <div style="margin-bottom: 2rem;">
        <p style="color: #9CA3AF; font-weight: 800; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem; border-bottom: 2px dashed #E5E7EB; padding-bottom: 0.75rem;">Order Details</p>
        <div>
            @foreach (var item in Model.TransactionDetails)
            {
                <div style="display:flex; justify-content:space-between; align-items: flex-start; margin-bottom: 1rem;">
                    <div style="flex: 1;">
                        <div style="font-weight: 800; color: #1F2937; font-size: 0.9rem;">@item.Product.Name</div>
                        <div style="font-size: 0.75rem; color: #6B7280; font-weight: 700;">
                            @item.Quantity × ₱@item.Price.ToString("N2")
                        </div>
                    </div>
                    <div style="font-weight: 900; color: #1F2937; font-size: 0.9rem;">₱@item.Subtotal.ToString("N2")</div>
                </div>
            }
        </div>
    </div>

    <div style="border-top: 2px dashed #E5E7EB; padding-top: 1.5rem;">
        <div style="display:flex; justify-content:space-between; margin-bottom: 0.6rem;">
            <span style="color: #6B7280; font-weight: 700; font-size: 0.85rem;">Subtotal</span>
            <span style="color: #1F2937; font-weight: 800; font-size: 0.9rem;">₱@((Model.TotalAmount / 1.12m).ToString("N2"))</span>
        </div>
        <div style="display:flex; justify-content:space-between; margin-bottom: 1rem;">
            <span style="color: #6B7280; font-weight: 700; font-size: 0.85rem;">VAT (12%)</span>
            <span style="color: #1F2937; font-weight: 800; font-size: 0.9rem;">₱@((Model.TotalAmount - (Model.TotalAmount / 1.12m)).ToString("N2"))</span>
        </div>
        
        <div class="total-banner" style="display:flex; justify-content:space-between; font-size: 1.5rem; font-weight: 900; color: #fff; background: var(--pos-primary); padding: 1rem 1.25rem; border-radius: 16px; margin-bottom: 1.5rem;">
            <span style="font-size: 0.85rem; align-self: center; opacity: 0.9; text-transform: uppercase; font-weight: 800;">Amount Due</span>
            <span>₱@Model.TotalAmount.ToString("N2")</span>
        </div>

        <div style="background: #F9FAFB; border-radius: 16px; padding: 1rem; border: 1px solid #F3F4F6;">
            <div style="display:flex; justify-content:space-between; margin-bottom: 0.5rem;">
                <span style="color: #6B7280; font-weight: 700; font-size: 0.85rem;">Cash Received</span>
                <span style="color: #1F2937; font-weight: 800; font-size: 0.95rem;">₱@Model.CashReceived.ToString("N2")</span>
            </div>
            <div style="display:flex; justify-content:space-between; padding-top: 0.5rem; border-top: 1px solid #E5E7EB;">
                <span style="color: #6B7280; font-weight: 800; font-size: 0.85rem;">Change</span>
                <span style="color: var(--pos-primary); font-weight: 900; font-size: 1.1rem;">₱@Model.Change.ToString("N2")</span>
            </div>
        </div>
    </div>

    <div style="text-align: center; margin-top: 2.5rem;">
        <p style="color: #111827; font-weight: 800; font-size: 0.85rem; margin-bottom: 0.5rem;">Thank you for your visit!</p>
        <p style="color: #9CA3AF; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;">
            This is a system-generated receipt.<br />
            Items sold are non-refundable unless defective.
        </p>
    </div>

    <div class="no-print" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2.5rem;">
        <button onclick="window.print()" class="btn-checkout" style="background: #F3F4F6; color: #4B5563; box-shadow: none; width: 100%; margin: 0; height: 54px; border-radius: 16px;">
            <i class="fas fa-print" style="margin-right: 0.5rem;"></i> Print
        </button>
        <button onclick="document.getElementById('detailsModal').style.display='none'" class="btn-checkout" style="width: 100%; margin: 0; height: 54px; border-radius: 16px; font-weight: 900;">
            Close
        </button>
    </div>
</div>
