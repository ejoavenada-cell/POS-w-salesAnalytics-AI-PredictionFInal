@model FoodOrderingSytemAIAnalytics.Models.User

<div style="padding: 2rem; max-height: 90vh; overflow-y: auto;">
    <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
            <h2 style="font-size: 1.25rem; font-weight: 900; color: #1F2937; margin-bottom: 0.25rem;">Edit User Profile</h2>
            <p style="color: #9CA3AF; font-weight: 700; font-size: 0.75rem; text-transform: uppercase;">ID: @Model.Id | @Model.Role</p>
        </div>
        <button type="button" onclick="document.getElementById('userModal').style.display='none'" style="background: none; border: none; color: #9CA3AF; cursor: pointer; font-size: 1.25rem;">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <form asp-controller="User" asp-action="@(ViewBag.IsSelfEdit == true ? "UpdateProfile" : "Edit")" method="post" enctype="multipart/form-data" class="premium-form">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" style="color: #EF4444; margin-bottom: 1rem; font-weight: 700; font-size: 0.8rem;"></div>

        <div style="margin-bottom: 1.25rem; background: #F9FAFB; padding: 1.25rem; border-radius: 16px; border: 1px solid #E5E7EB;">
            <label asp-for="ProfileImage" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.75rem;">Profile Photo</label>
            <div style="display: flex; gap: 1.5rem; align-items: center;">
                <div style="width: 80px; height: 80px; border-radius: 50%; background: #F3F4F6; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 2px solid white; box-shadow: 0 4px 10px rgba(0,0,0,0.1); flex-shrink: 0;">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" style="width: 100%; height: 100%; object-fit: cover;" id="userImagePreview" />
                    }
                    else
                    {
                        <i class="fas fa-user" style="font-size: 2rem; color: #D1D5DB;" id="userImagePlaceholder"></i>
                    }
                </div>
                <div style="flex: 1;">
                    <div style="border: 1.5px dashed #D1D5DB; border-radius: 12px; padding: 0.75rem; text-align: center; background: white; cursor: pointer;" onclick="document.getElementById('ProfileImage').click();">
                        <p style="margin: 0; font-weight: 700; color: #4B5563; font-size: 0.7rem;">Upload New Photo</p>
                        <input asp-for="ProfileImage" type="file" style="display: none;" onchange="updateUserFileName(this)" />
                    </div>
                    <div id="userFileNameDisplay" style="margin-top: 0.4rem; font-weight: 800; color: var(--primary-color); font-size: 0.65rem; display: none; word-break: break-all;"></div>
                </div>
            </div>
        </div>

        <div style="margin-bottom: 1.25rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                <span style="color: #9CA3AF; font-weight: 700; font-size: 0.65rem; text-transform: uppercase;">Avatar URL</span>
                <div style="flex: 1; height: 1px; background: #F3F4F6;"></div>
            </div>
            <input asp-for="ImageUrl" class="form-control" placeholder="https://..." style="height: 40px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 0.85rem; width: 100%; font-size: 0.85rem;" />
        </div>

        <div style="margin-bottom: 1.25rem;">
            <label asp-for="Name" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem;">Full Name</label>
            <input asp-for="Name" class="form-control" style="height: 44px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 1rem; width: 100%; font-size: 0.9rem;" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
            <div class="form-group">
                <label asp-for="Age" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem;">Age</label>
                <input asp-for="Age" type="number" class="form-control" style="height: 44px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 1rem; width: 100%;" />
            </div>
            <div class="form-group">
                <label asp-for="Sex" style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem;">Sex</label>
                <select asp-for="Sex" class="form-control" style="height: 44px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 1rem; width: 100%;">
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
            </div>
        </div>

        <div style="margin-bottom: 1.25rem;">
            <label style="display: block; font-weight: 800; color: #4B5563; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 0.4rem;">New Password (Leave blank to keep current)</label>
            <input type="password" name="NewPassword" class="form-control" style="height: 44px; border-radius: 10px; border: 1.5px solid #E5E7EB; padding: 0 1rem; width: 100%;" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
            @if (ViewBag.IsSelfEdit != true)
            {
                <div class="form-group" style="display: flex; align-items: center; gap: 0.6rem; background: #F9FAFB; padding: 0.75rem; border-radius: 12px;">
                    <input asp-for="IsActive" type="checkbox" style="width: 18px; height: 18px;" />
                    <label asp-for="IsActive" style="font-weight: 800; color: #4B5563; font-size: 0.8rem; margin: 0;">Account Active</label>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; justify-content: center; background: #F9FAFB; padding: 0.75rem; border-radius: 12px;">
                    <span style="font-size: 0.65rem; color: #9CA3AF; font-weight: 700; text-transform: uppercase;">Status</span>
                    <span style="font-size: 0.85rem; font-weight: 800; color: #10B981;">Active</span>
                </div>
            }
            <div style="display: flex; flex-direction: column; justify-content: center; background: #F9FAFB; padding: 0.75rem; border-radius: 12px;">
                <span style="font-size: 0.65rem; color: #9CA3AF; font-weight: 700; text-transform: uppercase;">Joined On</span>
                <span style="font-size: 0.85rem; font-weight: 800; color: #4B5563;">@Model.DateCreated.ToString("MMM dd, yyyy")</span>
            </div>
        </div>

        <div style="display: flex; gap: 0.75rem;">
            <button type="submit" class="btn-checkout" style="flex: 1; height: 52px; border-radius: 14px; font-weight: 900;">
                <i class="fas fa-save"></i> Save Changes
            </button>
            <button type="button" onclick="document.getElementById('userModal').style.display='none'" class="btn-checkout" style="width: 100px; height: 52px; border-radius: 14px; font-weight: 900; background: #F3F4F6; color: #4B5563; box-shadow: none;">
                Cancel
            </button>
        </div>
    </form>
</div>
